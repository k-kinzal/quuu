#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
  # Deletions introduce no objects, and must remain possible even without Gitleaks.
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac

  if ! tip=$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null); then
    echo "Secret scan blocked: $local_ref does not point to a commit." >&2
    exit 1
  fi

  # A new ref or an unknown remote tip has no safe local lower bound. Scan its
  # entire history instead of trusting potentially stale remote-tracking refs.
  range=$tip
  if base=$(git rev-parse --verify "$remote_oid^{commit}" 2>/dev/null); then
    range="$base..$tip"
  fi

  echo "Scanning outgoing history for $remote_ref..." >&2
  # Separate merge diffs include secrets introduced only by conflict resolution.
  sh "$root/scripts/scan-secrets.sh" --log-opts="--full-history --diff-merges=separate $range" </dev/null
done
