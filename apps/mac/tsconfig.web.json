{
  "include": [
    "src/renderer/**/*",
    "src/preload/api.ts",
    "src/preload/api/**/*.ts",
    "../../packages/design-system/src/**/*",
    "src/preload/contract.ts",
    "src/preload/events.ts",
    "src/preload/channels.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@design-system/react": [
        "../../packages/design-system/src/index.ts"
      ],
      "@/*": [
        "src/renderer/src/*"
      ]
    }
  }
}
