{
  "name": "quuu-workspace",
  "version": "1.0.0",
  "description": "Manages AI agent runs — a macOS app and an iPhone app",
  "author": "k-kinzal",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w quuu",
    "start": "npm run start -w quuu",
    "build": "npm run build -w quuu",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "pretest": "npm run build:pty -w quuu",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "npm run storybook -w @design-system/react",
    "build-storybook": "npm run build-storybook -w @design-system/react",
    "check": "npm run lint && npm run check:architecture && npm run typecheck && npm test",
    "dist": "npm run dist -w quuu",
    "dist:dmg": "npm run dist:dmg -w quuu",
    "app:restart": "npm run app:restart -w quuu",
    "icon": "bash scripts/build-icon.sh",
    "dev:fixture": "npm run dev:fixture -w quuu",
    "dev:shot": "npm run dev:shot -w quuu",
    "shot": "npm run shot -w quuu",
    "mobile:dev": "npm run dev -w @quuu/mobile",
    "mobile:build": "npm run build -w @quuu/mobile",
    "ios:build": "npm run ios:build -w @quuu/mobile",
    "ios:open": "npm run ios:open -w @quuu/mobile",
    "ios:install": "npm run ios:install -w @quuu/mobile",
    "check:architecture": "node --test scripts/architecture/*.test.mjs && node scripts/architecture/check.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/material": "^9.3.1",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "lucide-react": "^1.31.0"
  }
}
