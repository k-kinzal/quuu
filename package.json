{
  "name": "quuu-workspace",
  "version": "1.0.0",
  "description": "Manages AI agent runs — a macOS app and an iPhone app",
  "author": "k-kinzal",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run hooks:install",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "secrets:scan": "sh scripts/scan-secrets.sh --log-opts='--all --full-history --diff-merges=separate'",
    "dev": "npm run dev -w quuu",
    "start": "npm run start -w quuu",
    "build": "npm run build -w quuu",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "pretest": "npm run build:native -w quuu && npm run build:cli && npm run build:runner",
    "build:runner": "vite build --config apps/mac/runner.vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "npm run storybook -w @design-system/react",
    "build-storybook": "npm run build-storybook -w @design-system/react",
    "check": "npm run check:runtime && npm run lint && npm run check:architecture && npm run api:check && npm run typecheck && npm test",
    "dist": "npm run dist -w quuu",
    "dist:dmg": "npm run dist:dmg -w quuu",
    "dist:release": "npm run dist:release -w quuu",
    "app:restart": "npm run app:restart -w quuu",
    "icon": "bash scripts/build-icon.sh",
    "dev:fixture": "npm run dev:fixture -w quuu",
    "dev:shot": "npm run dev:shot -w quuu",
    "shot": "npm run shot -w quuu",
    "mobile:dev": "npm run dev -w @quuu/mobile",
    "mobile:build": "npm run build -w @quuu/mobile",
    "ios:build": "npm run ios:build -w @quuu/mobile",
    "ios:open": "npm run ios:open -w @quuu/mobile",
    "ios:install": "npm run ios:install -w @quuu/mobile",
    "check:architecture": "node --test scripts/architecture/*.test.mjs && node scripts/architecture/check.mjs",
    "api:generate": "vite-node -c vitest.config.ts apps/mac/scripts/generate-api.ts",
    "build:cli": "npm run build:cli -w quuu",
    "api:check": "vite-node -c vitest.config.ts apps/mac/scripts/generate-api.ts --check",
    "check:runtime": "node scripts/check-runtime-security.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/material": "^9.5.0",
    "@storybook/react-vite": "^10.6.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16",
    "vite-node": "^6.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.62.0"
  },
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
